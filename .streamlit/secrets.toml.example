# Copy to .streamlit/secrets.toml for local use (that file is gitignored),
# and paste the same content into Streamlit Cloud under
# your app -> Settings -> Secrets.

# --- Tableau Cloud -----------------------------------------------------------
# Server URL is the pod only, no /#/site/... path.
TABLEAU_SERVER_URL = "https://your-pod.online.tableau.com"
TABLEAU_SITE = "your-site"
TABLEAU_TOKEN_NAME = "your-token-name"
TABLEAU_TOKEN_SECRET = "paste-the-personal-access-token-secret"

# --- Gmail -------------------------------------------------------------------
# The desktop OAuth flow cannot run on a headless host, so the app uses a
# refresh token minted once locally. Get these from config/gmail_credentials.json
# and config/gmail_token.json after connecting Gmail in the app, or run:
#   python tools/export_gmail_secrets.py
GMAIL_CLIENT_ID = "xxxxx.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET = "paste-the-client-secret"
GMAIL_REFRESH_TOKEN = "paste-the-refresh-token"

# --- Shared settings storage -------------------------------------------------
# Lets everyone share saved reports, templates and mailing lists, and makes
# saving stick on hosts with no permanent disk (Streamlit Cloud).
# Create the gist with:  python tools/init_gist.py
# The token needs the `gist` scope ONLY - it cannot touch your repositories.
GITHUB_TOKEN = "ghp_paste-a-gist-scoped-token"
GITHUB_GIST_ID = "paste-the-gist-id"

# --- App login ---------------------------------------------------------------
# One shared credential for everyone who should be able to send reports.
[auth]
username = "your-shared-username"
password = "change-me"
# Signs the "keep me signed in" token. Rotate it to sign everyone out at once.
cookie_secret = "a-long-random-string"
session_days = 30
